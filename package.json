{
  "name": "tool-bridge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:unit": "pnpm --filter @tool-bridge/core --filter @tool-bridge/cli --filter @tool-bridge/sdk --filter @tool-bridge/plugin-sdk --filter @tool-bridge/plugins --filter @tool-bridge/dashboard test && pnpm test:provision && pnpm test:package-release",
    "test:provision": "node --test scripts/provision.test.mjs",
    "test:package-release": "node --test scripts/package-release.test.mjs",
    "test:integration": "pnpm --filter @tool-bridge/gateway --filter @tool-bridge/server --if-present test",
    "test": "turbo run test && pnpm test:provision && pnpm test:package-release",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "compose:up": "docker compose up -d --build",
    "compose:smoke": "docker compose run --rm smoke",
    "compose:down": "docker compose down --remove-orphans",
    "compose:reset": "docker compose down -v --remove-orphans",
    "gen-dev-vars": "node scripts/gen-dev-vars.mjs",
    "provision": "node scripts/provision.mjs",
    "release:plan": "node scripts/release-plan.mjs",
    "release:check-bumps": "node scripts/check-version-bumps.mjs",
    "smoke": "tsx scripts/smoke.ts",
    "verify:mcp": "tsx scripts/verify-mcp.ts",
    "verify:search": "pnpm --filter @tool-bridge/cli build && tsx scripts/verify-search.ts",
    "deploy:all": "node scripts/provision.mjs && pnpm --filter @tool-bridge/dashboard build && pnpm --filter @tool-bridge/gateway run deploy",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc}": [
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@modelcontextprotocol/client": "catalog:",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "catalog:",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsonc": "^2.21.1",
    "eslint-plugin-perfectionist": "^4.15.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsonc-parser": "^3.3.1",
    "lint-staged": "^16.4.0",
    "tsx": "catalog:",
    "turbo": "^2.10.9",
    "typescript": "catalog:",
    "typescript-eslint": "^8.64.0",
    "wrangler": "catalog:"
  }
}
