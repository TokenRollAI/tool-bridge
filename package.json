{
  "name": "tool-bridge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "analyze:dead-code": "knip",
    "test:unit": "pnpm --filter @tool-bridge/core --filter @tool-bridge/cli --filter @tool-bridge/sdk --filter @tool-bridge/plugin-sdk --filter @tool-bridge/plugins --filter @tool-bridge/dashboard test && pnpm test:package-release && pnpm test:dockerfile && pnpm test:deploy-ci",
    "test:deploy-ci": "node --test scripts/deploy-change-filter.test.mjs",
    "test:dockerfile": "node --test scripts/dockerfile-contract.test.mjs",
    "test:package-release": "node --test scripts/package-release.test.mjs",
    "test:integration": "pnpm --filter @tool-bridge/app --filter @tool-bridge/server --if-present test",
    "test": "turbo run test && pnpm test:package-release && pnpm test:dockerfile && pnpm test:deploy-ci && pnpm test:compose-snapshot",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "compose:up": "docker compose up -d --build",
    "compose:smoke": "docker compose exec -T app node -e \"fetch('http://127.0.0.1:8787/readyz').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))\"",
    "compose:down": "docker compose down --remove-orphans",
    "compose:reset": "docker compose --profile replicas down -v --remove-orphans",
    "release:plan": "node scripts/release-plan.mjs",
    "release:check-bumps": "node scripts/check-version-bumps.mjs",
    "smoke": "tsx scripts/smoke.ts",
    "verify:mcp": "tsx scripts/verify-mcp.ts",
    "verify:search": "pnpm --filter @tool-bridge/cli build && tsx scripts/verify-search.ts",
    "prepare": "husky",
    "test:compose-snapshot": "node --test scripts/compose-snapshot.test.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc}": [
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@modelcontextprotocol/client": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tool-bridge/core": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsonc": "^2.21.1",
    "eslint-plugin-perfectionist": "^4.15.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "knip": "6.32.2",
    "lint-staged": "^16.4.0",
    "tsx": "catalog:",
    "turbo": "^2.10.9",
    "typescript": "catalog:",
    "typescript-eslint": "^8.64.0",
    "zod": "catalog:",
    "commander": "~15.0.0",
    "tar": "^7.5.22"
  }
}
