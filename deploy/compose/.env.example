# tool-bridge 生产 compose 环境变量。复制为 .env 并填入真实值;.env 不入库。
# 必填两项缺失时 docker compose 直接报错(不会起一个 fail closed 循环重启的容器)。

# ===== 必填 =====
# 首次引导 Admin SK。生成:
#   node -e "console.log('tbk_'+require('crypto').randomBytes(32).toString('base64url'))"
TB_BOOTSTRAP_ADMIN_SK=

# SecretStore 主密钥(base64url 32B)。生成:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TB_SECRET_ENCRYPTION_KEY=

# Postgres 密码(用户/库名可保持缺省 toolbridge)。
TB_PG_PASSWORD=

# ===== 常用可选 =====
# 镜像(缺省 GHCR latest;固定版本如 ghcr.io/tokenrollai/tool-bridge:0.10.0)
# TB_IMAGE=ghcr.io/tokenrollai/tool-bridge:0.10.0
# 对外绑定地址与端口(缺省 127.0.0.1:8787;经反代出公网时保持 127.0.0.1)
# TB_BIND=0.0.0.0
# TB_PUBLIC_PORT=8787
# 规范 origin(反代/TLS/多域名时必设,钉死 OAuth redirect_uri)
# TB_CANONICAL_ORIGIN=https://tb.example.com
# SIGTERM 后 /readyz 先 503 再等这么多秒关停(缺省 5)
# TB_SHUTDOWN_DRAIN_SEC=5

# ===== 外部对象存储(可选;四项齐全才生效,半配拒绝启动)=====
# TB_OBJECT_STORE_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# TB_OBJECT_STORE_BUCKET=tb-objects
# TB_OBJECT_STORE_REGION=auto
# TB_OBJECT_STORE_ACCESS_KEY_ID=
# TB_OBJECT_STORE_SECRET_ACCESS_KEY=
