# tool-bridge 环境变量模板
# 复制为 .env 并填入真实值;.env 不入库(.gitignore)。
# 本地开发的 .dev.vars 由 scripts/gen-dev-vars.mjs 从 .env 白名单生成,不要手工维护两份。

# ============================================================
# Cloudflare 宿主(可选;Node/Docker 自部署不需要本节)
# 操作经本地 wrangler OAuth,无需 API Token
# ============================================================
# 你的 Cloudflare Account ID(`wrangler whoami` 可查)。
# 本节四个变量由 `pnpm provision` 回填进 packages/gateway/wrangler.jsonc
# (account_id / routes / TB_CANONICAL_ORIGIN / TB_R2_S3_ENDPOINT 与前缀派生的资源名),
# 仓库里那份配置因此不含任何账户特定值。
CLOUDFLARE_ACCOUNT_ID=

# 可选:CI/无头环境用 API Token 代替本地 wrangler OAuth 登录。
# 本地开发留空即可(wrangler 用你已登录的 OAuth 凭据)。
# 注意:Account-scoped token 的验证一律用 `wrangler whoami`,勿用 /user/tokens/verify(必然误报)。
# CLOUDFLARE_API_TOKEN=

# ============================================================
# 部署形态
# ============================================================
# 生产 BaseURL:TB_DOMAIN 写成 custom domain 路由(zone 需在同一 Cloudflare 账户下),
# TB_BASE_URL 是完整 origin,钉死 OAuth redirect_uri。留空则不写路由/不钉 origin。
TB_DOMAIN=
TB_BASE_URL=

# 云上资源统一前缀(worker/KV/R2/D1 命名派生:tb-gateway / tb-kv / tb-r2 / tb-search)
TB_NAME_PREFIX=tb

# ============================================================
# Node / Docker 宿主(@tool-bridge/server;与 Cloudflare 宿主二选一)
# ============================================================
# 数据落盘目录(SQLite 状态库 + objects/ 对象根);容器里通常挂成 /data 卷。
# TB_DATA_DIR=./data
# TB_PORT=8787
# TB_HOST=0.0.0.0
# 多域名访问时钉死 OAuth redirect_uri(与 Workers 宿主同一语义;非法值拒绝启动)。
# TB_CANONICAL_ORIGIN=
# k8s/LB 滚动更新:SIGTERM 后先让 /readyz 转 503、等这么多秒再真正关停(缺省 0 = 立即)。
# TB_SHUTDOWN_DRAIN_SEC=10

# ============================================================
# 信任根(env-only,不走 SecretStore 回退)
# ============================================================
# 首次引导的 Admin SK。CLI 部署由 `tb init cloudflare` 自动生成并安全注入；手工部署时生成：
#   node -e "console.log('tbk_'+require('crypto').randomBytes(32).toString('base64url'))"
# Workers 经 Deploy Button 或 `wrangler deploy --secrets-file` 注入；Node/Docker 直接传入环境变量。
TB_BOOTSTRAP_ADMIN_SK=

# SecretStore 主密钥:32 字节 base64url。生成:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Workers 经 `wrangler secret put TB_SECRET_ENCRYPTION_KEY` 注入,本地进 .dev.vars;
# Node/Docker 直接作为进程环境变量传入。
TB_SECRET_ENCRYPTION_KEY=

# ============================================================
# R2 预签名($ref 大对象直连下载;Cloudflare 宿主)
# ============================================================
# R2 binding 不支持 presign——需要一对 R2 S3 兼容 Access Key(Dashboard → R2 → Manage API Tokens 创建,
# 权限:Object Read & Write,限定 context bucket)。留空则大对象走网关中转下载(功能不缺,带宽走 Worker)。
# 部署后建议改经 `tb secret set` 存入 SecretStore,而非长期留在 .env。
# TB_R2_ACCESS_KEY_ID=
# TB_R2_SECRET_ACCESS_KEY=

# ============================================================
# CLI / 测试驱动(E2E 与集成测试用)
# ============================================================
# `tb` CLI 的默认目标(也可用 `tb use <server>` 管理多目标)
TB_SK=            # 部署后由 tb init 输出的 Admin SK 填入(明文只输出一次)

# Phase 2 / E2E-5 的真实上游 MCP server(Streamable HTTP);
# 留空则测试用自建 echo MCP 兜底
# TB_TEST_MCP_URL=
# TB_TEST_MCP_BEARER=

# Phase 3 / E2E-2 的"外部 S3"兼容端点(任意 S3 兼容服务即可,例如 R2 的 S3 API:
#   https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com)
# TB_TEST_S3_ENDPOINT=
# TB_TEST_S3_ACCESS_KEY_ID=
# TB_TEST_S3_SECRET_ACCESS_KEY=
# TB_TEST_S3_BUCKET=
