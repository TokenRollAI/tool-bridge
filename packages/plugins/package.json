{
  "name": "@tool-bridge/plugins",
  "version": "0.1.0",
  "private": true,
  "description": "Built-in plugin catalog: every provider under src/ can be mounted directly by an assembled host",
  "type": "module",
  "exports": {
    ".": "./src/registry.ts",
    "./feishu": "./src/feishu/index.ts",
    "./guarded-fetch": "./src/_runtime/guardedFetch.ts",
    "./notes": "./src/notes/index.ts"
  },
  "scripts": {
    "generate": "pnpm generate:registry && pnpm generate:catalog",
    "generate:catalog": "tsx scripts/generateCatalog.ts",
    "generate:registry": "node scripts/generateRegistry.mjs",
    "serve": "tsx scripts/serve.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "@tool-bridge/plugin-sdk": "workspace:*",
    "ipaddr.js": "2.5.0",
    "zod": "catalog:",
    "@modelcontextprotocol/client": "catalog:"
  },
  "devDependencies": {
    "@hono/node-server": "catalog:",
    "@tool-bridge/core": "workspace:*",
    "tsx": "catalog:",
    "vitest": "catalog:"
  }
}
