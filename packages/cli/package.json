{
  "name": "@tool-bridge/cli",
  "version": "0.14.0",
  "description": "tb — Tool Bridge CLI: one gateway for HTBP/MCP/HTTP tools, contexts, and device shells",
  "type": "module",
  "license": "MIT",
  "bin": {
    "tb": "dist/index.js"
  },
  "files": [
    "dist",
    "scripts/build-binary.sh"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "cli",
    "mcp",
    "htbp",
    "tool-bridge",
    "agent-tools"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "build:binary": "sh scripts/build-binary.sh",
    "dev": "tsx src/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "partysocket": "catalog:",
    "ws": "catalog:"
  },
  "devDependencies": {
    "@tool-bridge/core": "workspace:*",
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "tsup": "catalog:",
    "vitest": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TokenRollAI/tool-bridge.git",
    "directory": "packages/cli"
  }
}
