{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // 宿主中立层:产物必须能被 Workers / Node / Deno / Bun 任意宿主装载,故只认
    // Web 标准全局(fetch 家族 / WebCrypto / TextEncoder)。**刻意不引
    // @cloudflare/workers-types 也不引 @types/node** —— types 收窄为空,
    // 让类型系统而非人工纪律来保证这一层不出现 KVNamespace / R2Bucket / process 之类的
    // 宿主专属符号。宿主差异一律经 TbAppDeps 的五个注入点(StateStore / ObjectStore /
    // SecretStore / DeviceTransport / SearchIndex)传入。
    "lib": ["ES2023", "DOM"],
    "types": []
  },
  "include": ["src", "tsup.config.ts"]
}
