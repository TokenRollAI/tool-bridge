{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // 宿主中立层:产物必须能被 Workers / Node / Deno / Bun 任意宿主装载,故只认
    // Web 标准全局(fetch 家族 / WebCrypto / TextEncoder)。**刻意不引
    // @cloudflare/workers-types 也不引 @types/node** —— types 收窄为空,
    // 让类型系统而非人工纪律来保证这一层不出现 KVNamespace / R2Bucket / process 之类的
    // 宿主专属符号。宿主差异一律经 TbAppDeps 的五个注入点(StateStore / ObjectStore /
    // SecretStore / DeviceTransport / SearchIndex)传入。
    //
    // test/ 一并纳入这条约束(见下方 include):测试跑在 Node 上,但仍不得使用 Node
    // 专属 API——它们打的是同一套中立面,拿 process/Buffer 写断言等于绕过验证对象。
    // 需要 env 开关或真实 binding 的 opt-in 用例留在 packages/gateway 的 workerd 套件。
    // DOM.Iterable:`Headers` 按 WHATWG Fetch 规范在每个目标宿主都可迭代
    // (`headers.entries()/keys()`),缺了它会被误判为不存在。补齐,不是放宽。
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": []
  },
  "include": ["src", "test", "tsup.config.ts", "vitest.config.ts"]
}
