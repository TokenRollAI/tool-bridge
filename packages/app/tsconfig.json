{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // app 的公开依赖面只使用 Web 标准全局(fetch/WebCrypto/TextEncoder)，
    // 宿主实现通过 TbAppDeps 注入；types 收窄为空，阻止 Node 专属全局泄漏。
    // test/ 同样遵守这条边界，Node socket 与真实 PG/S3 行为在 server 套件验证。
    // DOM.Iterable:`Headers` 按 WHATWG Fetch 规范在每个目标宿主都可迭代
    // (`headers.entries()/keys()`),缺了它会被误判为不存在。补齐,不是放宽。
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": []
  },
  "include": ["src", "test", "tsup.config.ts", "vitest.config.ts"]
}
