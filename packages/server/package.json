{
  "name": "@tool-bridge/server",
  "version": "0.15.0",
  "description": "tool-bridge self-hosted server: run the HTBP gateway on Node with SQLite or PostgreSQL persistence, filesystem object storage and WebSocket device channel — single container via docker run",
  "type": "module",
  "license": "MIT",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "tool-bridge-server": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "keywords": [
    "self-hosted",
    "docker",
    "mcp",
    "htbp",
    "tool-bridge",
    "agent-tools"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsup",
    "start": "tsx src/main.ts"
  },
  "dependencies": {
    "@cfworker/json-schema": "catalog:",
    "@hono/node-server": "catalog:",
    "@tool-bridge/dashboard": "workspace:*",
    "aws4fetch": "catalog:",
    "better-sqlite3": "^12.6.0",
    "hono": "catalog:",
    "ioredis": "^6.0.0",
    "postgres": "^3.4.9",
    "ws": "catalog:"
  },
  "devDependencies": {
    "@tool-bridge/app": "workspace:*",
    "@tool-bridge/core": "workspace:*",
    "@tool-bridge/plugins": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "vitest": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TokenRollAI/tool-bridge.git",
    "directory": "packages/server"
  }
}
