{
  "name": "@tool-bridge/server",
  "version": "0.23.0",
  "description": "Self-hosted Tool Bridge Node server with PostgreSQL, S3 object storage and WebSocket device channels",
  "type": "module",
  "license": "MIT",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "tool-bridge-server": "./dist/main.js",
    "tool-bridge-admin": "./dist/admin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "keywords": [
    "self-hosted",
    "docker",
    "mcp",
    "htbp",
    "tool-bridge",
    "agent-tools"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsup",
    "start": "tsx src/main.ts"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@tool-bridge/dashboard": "workspace:*",
    "hono": "catalog:",
    "ioredis": "^6.0.0",
    "postgres": "^3.4.9",
    "ws": "catalog:",
    "@aws-sdk/client-s3": "^3.1127.0",
    "@smithy/node-http-handler": "^4.12.1",
    "ipaddr.js": "^2.5.0",
    "write-file-atomic": "^7.0.0",
    "proper-lockfile": "^4.1.2",
    "zod": "catalog:",
    "commander": "~15.0.0",
    "p-retry": "^7.1.1",
    "negotiator": "^1.0.0"
  },
  "devDependencies": {
    "@tool-bridge/app": "workspace:*",
    "@tool-bridge/core": "workspace:*",
    "@tool-bridge/plugins": "workspace:*",
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "vitest": "catalog:",
    "@types/write-file-atomic": "^4.0.3",
    "@types/proper-lockfile": "^4.1.4",
    "@types/negotiator": "^0.6.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TokenRollAI/tool-bridge.git",
    "directory": "packages/server"
  }
}
