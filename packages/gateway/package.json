{
  "name": "@tool-bridge/gateway",
  "version": "0.4.0",
  "description": "Cloudflare Workers host adapter for tool-bridge: binds KV / R2 / D1 / Durable Objects / Static Assets to the host-neutral @tool-bridge/app, and default-exports the Worker plus the DeviceSession Durable Object",
  "type": "module",
  "license": "MIT",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "keywords": [
    "cloudflare-workers",
    "mcp",
    "htbp",
    "tool-bridge",
    "agent-tools"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "wrangler dev",
    "build": "tsup",
    "deploy": "wrangler deploy",
    "echo-mcp": "tsx scripts/echo-mcp.ts",
    "s3-mock": "tsx scripts/s3-mock.ts",
    "stub-provider": "tsx scripts/stub-provider.ts"
  },
  "dependencies": {
    "@cfworker/json-schema": "catalog:",
    "@modelcontextprotocol/client": "catalog:",
    "@modelcontextprotocol/core": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "aws4fetch": "catalog:",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@tool-bridge/app": "workspace:*",
    "@tool-bridge/core": "workspace:*",
    "@tool-bridge/dashboard": "workspace:*",
    "s3rver": "^3.7.1",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:zod4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TokenRollAI/tool-bridge.git",
    "directory": "packages/gateway"
  }
}
