{
  "name": "@tool-bridge/sdk",
  "version": "0.6.0",
  "description": "tool-bridge SDK: embed a TB instance (createToolBridge), register local providers, and connect to a remote gateway",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "sdk",
    "mcp",
    "htbp",
    "tool-bridge",
    "agent-tools"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "test": "vitest run"
  },
  "dependencies": {
    "@cfworker/json-schema": "catalog:",
    "aws4fetch": "catalog:",
    "hono": "catalog:",
    "partysocket": "catalog:",
    "ws": "catalog:"
  },
  "devDependencies": {
    "@hono/node-server": "catalog:",
    "@tool-bridge/app": "workspace:*",
    "@tool-bridge/core": "workspace:*",
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "tsup": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TokenRollAI/tool-bridge.git",
    "directory": "packages/sdk"
  }
}
