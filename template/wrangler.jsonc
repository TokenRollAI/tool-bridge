{
  // tool-bridge gateway — deployable to any Cloudflare account.
  // The "Deploy to Cloudflare" button reads this file, provisions the D1 database
  // / R2 bucket / Durable Object below in your account, and fills in the resource
  // ids automatically.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tool-bridge",
  "main": "src/index.ts",
  // Kept aligned with the source deployment and its verified workerd runtime.
  "compatibility_date": "2026-07-08",
  "compatibility_flags": ["nodejs_compat"],
  // Keep the account's workers.dev hostname, but do not expose per-version alternate origins.
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  // Every authenticated request reads authoritative D1 state. Keep the Worker close
  // to its dominant backends so repeated D1/upstream round trips do not cross regions.
  "placement": { "mode": "smart" },
  // R2: context objects and large $ref payloads.
  "r2_buckets": [
    { "binding": "TB_R2", "bucket_name": "tool-bridge" }
  ],
  // Durable Objects: one DeviceSession per device (WebSocket hibernation).
  "durable_objects": {
    "bindings": [{ "name": "TB_DEVICE", "class_name": "DeviceSession" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DeviceSession"] }],
  // D1: one database, two bindings (the deploy flow provisions it and fills in the id).
  // TB_STATE is the authoritative state store (node tree, SecretKey hashes, encrypted
  // secrets, plugin manifests — strongly consistent, revocation is immediate).
  // TB_SEARCH is the weighted LIKE tool-search index (`~search`).
  "d1_databases": [
    {
      "binding": "TB_STATE",
      "database_name": "tool-bridge-db",
      "database_id": "00000000-0000-0000-0000-000000000000"
    },
    {
      "binding": "TB_SEARCH",
      "database_name": "tool-bridge-db",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  // Dashboard static assets, copied from @tool-bridge/dashboard by
  // scripts/copy-ui.mjs (the dev/deploy scripts run it for you).
  // run_worker_first=true: every request enters the Worker first; the /ui route
  // forwards to assets explicitly, so the SPA fallback never swallows the data plane.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
